	<!-- docs/breeze-design.md section 4 (#111): the companion's own icons, 16 px
	     (tree, Items) and 32 px (List View), a stylised gust drawn by
	     tools/make_icons.py. A device keeps the icons of the build that created
	     it (V24). -->
	<small image_source="c4z">images/devices_sm/modernforms_breeze_16.png</small>
	<large image_source="c4z">images/devices_lg/modernforms_breeze_32.png</large>
	<control>lua_gen</control>
	<controlmethod>IP</controlmethod>
	<driver>DriverWorks</driver>
	<!-- The fan driver's minimum (docs/v1-design.md section 2.1: 3.3.0, the
	     light_v2 brightness target API); the companion is added by the fan
	     item's Add Breeze Switch, so it needs nothing the fan driver does not. -->
	<minimum_os_version>3.3.0</minimum_os_version>
	<config>
		<script jit="1" file="driver.lua"/>
		<documentation file="www/documentation.html"/>
		<!-- docs/breeze-design.md section 4: these three rows, never reordered. -->
		<properties>
			<property>
				<name>Driver Version</name>
				<default></default>
				<type>STRING</type>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Status</name>
				<default></default>
				<type>STRING</type>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Debug Mode</name>
				<type>LIST</type>
				<items>
					<item>Off</item>
					<item>On</item>
				</items>
				<default>Off</default>
				<readonly>false</readonly>
			</property>
		</properties>
		<!-- No actions and no commands of its own: the fan item has the Breeze
		     commands for programming, and the switch is used from its tile. -->
	</config>
	<proxies>
		<proxy proxybindingid="5001" name="Modern Forms Breeze" image_source="c4z" small_image="images/devices_sm/modernforms_breeze_16.png" large_image="images/devices_lg/modernforms_breeze_32.png">light_v2</proxy>
	</proxies>
	<!-- docs/breeze-design.md section 4 and edge-cases-breeze.md 3.2: an on/off
	     light_v2 switch, as the Hue project's Hue Scene was before it became a
	     dimmer. No dimming, no LEDs, no Button Links (keypads use the fan's link
	     311), no Advanced Lighting Scenes (reduced_als_support False, BE7). A
	     switch reports LIGHT_BRIGHTNESS_CHANGED only [LV2
	     35/_10.2-LIGHTBRIGHTNESSCHANGED.md, usage note]; supports_target keeps the
	     brightness-target API, so a target arrives as SET_BRIGHTNESS_TARGET.
	     hide_proxy_properties: the proxy's settings page (on preset, rates)
	     has nothing to set on a switch [LV2 5/_38-HIDEPROXYPROPERTIES.md]. -->
	<capabilities>
		<dimmer>False</dimmer>
		<set_level>False</set_level>
		<ramp_level>False</ramp_level>
		<on_off>True</on_off>
		<min_max>False</min_max>
		<click_rates>False</click_rates>
		<hold_rates>False</hold_rates>
		<cold_start>False</cold_start>
		<has_leds>False</has_leds>
		<has_button_events>False</has_button_events>
		<supports_target>True</supports_target>
		<supports_brightness_stop>False</supports_brightness_stop>
		<supports_color>False</supports_color>
		<supports_color_correlated_temperature>False</supports_color_correlated_temperature>
		<supports_broadcast_scenes>False</supports_broadcast_scenes>
		<supports_multichannel_scenes>False</supports_multichannel_scenes>
		<supports_default_on>False</supports_default_on>
		<advanced_scene_support>False</advanced_scene_support>
		<load_group_support>False</load_group_support>
		<reduced_als_support>False</reduced_als_support>
		<hide_proxy_properties>True</hide_proxy_properties>
		<hide_proxy_events>False</hide_proxy_events>
		<buttons_are_virtual>True</buttons_are_virtual>
	</capabilities>
